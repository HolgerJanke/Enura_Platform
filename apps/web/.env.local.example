NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PLATFORM_ROOT_DOMAIN=enura-group.com
# Client-visible copy — used by lib/platform.ts for tenant subdomain URLs.
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=enura-group.com
DEV_DEFAULT_TENANT_SLUG=alpen-energie
MOCK_AUTH=false
DEV_HOLDING_ADMIN=false
# Transactional email (invite credentials). If unset, accounts are still created
# and the admin is shown the temp password to relay manually.
RESEND_API_KEY=
EMAIL_FROM=
